DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_ENGINE=django.db.backends.postgresql
DB_NAME=erp_saas_dev
DB_USER=erp_saas_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Email (FASE 4). En desarrollo, "console" imprime los correos (p. ej. el
# de recuperación de contraseña) en la terminal/log en vez de enviarlos de
# verdad. Un proveedor SMTP real es una decisión de FASE 21 (Hostinger).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@erp-saas.local

REDIS_URL=redis://127.0.0.1:6379/0

# Billing SaaS / PayPal (FASE 16, ver docs/paypal.md). El access token
# OAuth2 NUNCA se guarda (ni aquí ni en base de datos) — se pide en
# vivo y se cachea solo en memoria del proceso; por eso ya no existe
# una variable PAYPAL_ACCESS_TOKEN (se retiró: guardarlo violaría la
# regla "no registrar access tokens" de docs/paypal.md).
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

APP_BASE_URL=http://127.0.0.1:8000

# Backups + Disaster Recovery (FASE 20, ver docs/backup-recovery.md).
# Todas opcionales — valores por defecto sensatos si se omiten.
# BACKUP_ROOT: carpeta donde viven los backups (por defecto <raíz del proyecto>/backups).
# BACKUP_RETENTION_DAILY_DAYS / _WEEKLY_WEEKS / _MONTHLY_MONTHS: política de retención.
# BACKUP_MIN_FREE_BYTES: espacio libre mínimo exigido antes de un backup.
# BACKUP_ENCRYPTION_KEY: si se define, los backups de base de datos se cifran con openssl
#   (AES-256-CBC + PBKDF2); vacío = backups SIN cifrar (documentado como tal, nunca fingido).
# BACKUP_OFFSITE_ROOT: si se define, cada backup se copia también a este segundo directorio
#   (típicamente otro disco/punto de montaje) — vacío = solo local.
BACKUP_ROOT=
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4
BACKUP_RETENTION_MONTHLY_MONTHS=12
BACKUP_MIN_FREE_BYTES=524288000
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_ROOT=
